rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isNonEmptyString(value) {
      return value is string && value.size() > 0 && value.size() < 500;
    }

    function isValidCateringInquiry() {
      return request.resource.data.keys().hasAll([
          'name',
          'phone',
          'email',
          'eventDate',
          'location',
          'guestCount',
          'budget',
          'serviceType',
          'menuPreferences',
          'message',
          'status',
          'createdAt'
        ])
        && request.resource.data.status == 'new'
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.phone)
        && isNonEmptyString(request.resource.data.email)
        && isNonEmptyString(request.resource.data.eventDate)
        && isNonEmptyString(request.resource.data.location)
        && isNonEmptyString(request.resource.data.budget)
        && isNonEmptyString(request.resource.data.serviceType)
        && request.resource.data.menuPreferences is list
        && request.resource.data.menuPreferences.size() <= 10
        && request.resource.data.guestCount is number
        && request.resource.data.guestCount > 0
        && request.resource.data.guestCount < 10000
        && request.resource.data.message is string
        && request.resource.data.message.size() < 5000;
    }

    match /menuItems/{itemId} {
      allow read: if resource.data.available == true;
      allow write: if false;
    }

    match /cateringInquiries/{inquiryId} {
      allow create: if isValidCateringInquiry();
      allow read, update, delete: if false;
    }
  }
}
